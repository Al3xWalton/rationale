opam-version: "2.0"
synopsis: "Deterministic proof kernel for Rationale"
maintainer: "Alexander Walton <alexander@walton-i.com>"
authors: "Alexander Walton <alexander@walton-i.com>"
license: "Apache-2.0"
homepage: "https://github.com/Al3xWalton/rationale"
bug-reports: "https://github.com/Al3xWalton/rationale/issues"
depends: [
  "ocaml" {>= "5.5.1" & < "5.6"}
  "dune" {>= "3.20"}
  "yojson" {>= "3.0" & < "4.0"}
  "alcotest" {with-test}
  "qcheck" {with-test & >= "0.91" & < "1.0"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
