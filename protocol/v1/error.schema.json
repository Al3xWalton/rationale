{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rationale.dev/protocol/v1/error.schema.json",
  "title": "Rationale protocol error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "enum": [
        "unsupported_protocol",
        "invalid_request",
        "missing_record",
        "resource_limit",
        "internal"
      ]
    },
    "message": { "type": "string", "minLength": 1 }
  }
}
